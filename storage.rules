rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function memberPath(workspaceId) {
      return /databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }
    function isMember(workspaceId) {
      return signedIn() && firestore.exists(memberPath(workspaceId));
    }
    function memberRole(workspaceId) {
      return firestore.get(memberPath(workspaceId)).data.role;
    }
    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && memberRole(workspaceId) in roles;
    }
    function canReview(workspaceId) {
      return hasRole(workspaceId, ['admin', 'reviewer']);
    }
    function supportedType() {
      return request.resource.contentType in [
        'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
      ];
    }

    match /workspaces/{workspaceId}/invoices/{invoiceId}/source/{fileName} {
      allow read: if hasRole(workspaceId, ['admin', 'reviewer', 'viewer']);
      allow create: if canReview(workspaceId)
        && request.resource.size < 20 * 1024 * 1024
        && supportedType();
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId}/invoices/{invoiceId}/previews/{fileName} {
      allow read: if hasRole(workspaceId, ['admin', 'reviewer', 'viewer']);
      allow write: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
