{
  "name": "ledger-ai-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/**/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "deploy": "firebase deploy --only functions:processInvoice,functions:reviewInvoice,functions:setInvoicePaymentStatus,functions:deleteInvoice"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
