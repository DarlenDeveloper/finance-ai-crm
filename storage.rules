rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function canonicalWorkspace(workspaceId) {
      return workspaceId == 'ws_Vv8hNHNb11TIlHTkkhmgBW6us502';
    }
    function memberPath(workspaceId) {
      return /databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }
    function isActiveMember(workspaceId) {
      return canonicalWorkspace(workspaceId)
        && signedIn()
        && firestore.exists(memberPath(workspaceId))
        && firestore.get(memberPath(workspaceId)).data.status == 'active';
    }
    function memberRole(workspaceId) {
      return firestore.get(memberPath(workspaceId)).data.role;
    }
    function isSuperAdmin(workspaceId) {
      return isActiveMember(workspaceId)
        && request.auth.uid == 'Vv8hNHNb11TIlHTkkhmgBW6us502'
        && memberRole(workspaceId) == 'super_admin';
    }
    function hasInvoicePage(workspaceId) {
      return isActiveMember(workspaceId)
        && (isSuperAdmin(workspaceId)
          || firestore.get(memberPath(workspaceId)).data.pageAccess.hasAny([
            'overview', 'invoices', 'review', 'analytics',
            'sales-performance', 'follow-ups'
          ]));
    }
    function canOperate(workspaceId) {
      return isActiveMember(workspaceId)
        && memberRole(workspaceId) in ['super_admin', 'admin', 'developer'];
    }
    function supportedType() {
      return request.resource.contentType in [
        'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
      ];
    }

    match /workspaces/{workspaceId}/invoices/{invoiceId}/source/{fileName} {
      allow read: if hasInvoicePage(workspaceId);
      allow create: if canOperate(workspaceId)
        && hasInvoicePage(workspaceId)
        && request.resource.size < 20 * 1024 * 1024
        && supportedType();
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId}/invoices/{invoiceId}/previews/{fileName} {
      allow read: if hasInvoicePage(workspaceId);
      allow write: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
